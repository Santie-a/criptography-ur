# Variables del servidor (python -m server). Todas son opcionales.
# Copia este archivo a .env solo como referencia: el servidor lee variables de
# entorno, no el archivo. En Render se configuran en "Environment".

# Persistencia en PostgreSQL (Supabase, session pooler). NO subir al repositorio.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Token del administrador. Sin él, cualquiera controla la red (modo abierto).
# Usa un valor largo y aleatorio, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MINICHAIN_ADMIN_TOKEN=

# production: sin token nadie es administrador (en Render se activa solo).
# MINICHAIN_ENV=production

# Escrituras públicas por minuto y por IP (0 = sin límite).
# MINICHAIN_RATE_LIMIT=60

# Minar la mempool cada N segundos (0 = solo minado manual).
# MINICHAIN_AUTOMINE=0

# Monedas de bienvenida para cada billetera de dispositivo nueva (0 = desactivado).
# MINICHAIN_FAUCET=25

# URL pública para el código QR de "Invitar". En Render se usa RENDER_EXTERNAL_URL.
# MINICHAIN_PUBLIC_URL=http://192.168.1.20:8000

# Alternativa local: guardar la red en un archivo JSON.
# MINICHAIN_STATE_FILE=red.json

# Red y escenario inicial
# MINICHAIN_HOST=127.0.0.1        # 0.0.0.0 para aceptar conexiones de otros equipos
# PORT=8000                        # Render lo asigna solo
# MINICHAIN_SEED=2026
# MINICHAIN_DIFFICULTY=14
# MINICHAIN_MAX_DIFFICULTY=22
# MINICHAIN_CORS=http://localhost:5173,http://127.0.0.1:5173
