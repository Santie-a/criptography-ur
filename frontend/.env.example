# URL pública de la API. Vacío = mismo origen que la UI (lo normal: el
# servidor de Python sirve la UI compilada, o Vite reenvía /api en desarrollo).
# Ejemplo si la API vive en otro dominio: VITE_API_URL=https://api.ejemplo.com
VITE_API_URL=

# Solo para `npm run dev`: a dónde reenvía Vite las llamadas /api.
MINICHAIN_API=http://127.0.0.1:8000
